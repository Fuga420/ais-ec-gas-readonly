# B.I.S EC 商品マスター移行・Cloud Run API 用 設定テンプレート
# 使い方: このファイルを .env.supabase.local にコピーして値を設定してください（.env.supabase.local は Git 追跡対象外です）。
# ※ `npx supabase login` を実行済みの場合は SUPABASE_PROJECT_REF のみ指定すれば CLI から URL / キーの自動取得も可能です。

# Supabase Project Reference ID（例: abcdefghijklmnopqrst）
SUPABASE_PROJECT_REF=

# Supabase Project URL（例: https://abcdefghijklmnopqrst.supabase.co）
SUPABASE_URL=

# Supabase service_role secret key（サーバー/移行スクリプト専用・フロントエンド公開厳禁）
SUPABASE_SERVICE_ROLE_KEY=

# 移行元の現行 GAS Web App URL（省略時は現行本番 URL を使用）
GAS_WEB_APP_URL=

# Cloud Run 商品API URL（照合スクリプト・ヘルスチェック用）
CLOUD_RUN_PRODUCTS_API_URL=

# Cloud Scheduler / 内部CLIスクリプト専用の同期トークン（GCP Secret Manager と同一値、ブラウザ公開厳禁）
PRODUCTS_API_INTERNAL_SECRET=


